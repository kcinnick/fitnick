# Copy this file to .env at the repository root and replace placeholder values.
# .env is gitignored and should never be committed.

FITNICK_HEALTH_PROVIDER=google
FITNICK_OFFLINE_MODE=0
FITNICK_AUTO_REFRESH_TOKENS=1
FITNICK_PROACTIVE_REFRESH_TOKENS=1
FITNICK_TOKEN_REFRESH_BUFFER_SECONDS=300
FITNICK_TOKEN_REFRESH_UNKNOWN_INTERVAL_SECONDS=3600

# Caller authentication (service-to-service)
FITNICK_REQUIRE_AUTH=1
FITNICK_AUTH_EXEMPT_PATHS=/health,/healthz,/openapi.json,/login,/logout,/admin/login
FITNICK_API_KEY=replace-with-long-random-key
FITNICK_BASIC_AUTH_USER=
FITNICK_BASIC_AUTH_PASS=

# Google Health OAuth credentials
GOOGLE_HEALTH_ACCESS_TOKEN=replace-with-access-token
GOOGLE_HEALTH_REFRESH_TOKEN=replace-with-refresh-token
GOOGLE_HEALTH_CLIENT_ID=replace-with-client-id
GOOGLE_HEALTH_CLIENT_SECRET=replace-with-client-secret

# Fitbit OAuth credentials (required when FITNICK_HEALTH_PROVIDER=fitbit)
FITBIT_ACCESS_TOKEN=replace-with-fitbit-access-token
FITBIT_REFRESH_TOKEN=replace-with-fitbit-refresh-token
FITBIT_AUTH_HEADER=replace-with-base64-clientid-colon-secret

# Django local settings
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost,testserver
DJANGO_SECRET_KEY=replace-with-local-secret
