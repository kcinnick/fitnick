# Copy this file to .env at the repository root and replace placeholder values.
# .env is gitignored and should never be committed.

FITNICK_HEALTH_PROVIDER=google
FITNICK_OFFLINE_MODE=0

# Google Health OAuth credentials
GOOGLE_HEALTH_ACCESS_TOKEN=replace-with-access-token
GOOGLE_HEALTH_REFRESH_TOKEN=replace-with-refresh-token
GOOGLE_HEALTH_CLIENT_ID=replace-with-client-id
GOOGLE_HEALTH_CLIENT_SECRET=replace-with-client-secret

# Django local settings
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost,testserver
DJANGO_SECRET_KEY=replace-with-local-secret
